    <!-- Onboarding -->
    <string name="c_onboarding_welcome">Welcome to Memdroid</string>
    <string name="c_onboarding_tagline">A privacy-first, offline app with no ads, bringing useful tools to everyone for free.</string>
    <string name="c_onboarding_privacy_title">Privacy first</string>
    <string name="c_onboarding_privacy_body">Nothing you do in Memdroid leaves your device.</string>
    <string name="c_onboarding_offline_title">Works offline</string>
    <string name="c_onboarding_offline_body">No account and no tracking. It doesn\'t need the internet.</string>
    <string name="c_onboarding_no_ads_title">No ads, ever</string>
    <string name="c_onboarding_no_ads_body">No banners, no pop-ups, no paid features.</string>
    <string name="c_onboarding_free_title">Free for everyone</string>
    <string name="c_onboarding_free_body">Kept going by supporters on the heroes wall.</string>
    <string name="c_onboarding_what_title">What Memdroid does</string>
    <string name="c_onboarding_what_body">Memdroid shows what\'s using your device\'s memory, storage and battery, and helps you free it up. Let\'s set up a few permissions. You can skip any of them and change them later in Settings.</string>
    <string name="c_onboarding_usage_title">Usage access</string>
    <string name="c_onboarding_usage_body">Lets Memdroid measure each app\'s storage, see when you last used it and spot battery drain.</string>
    <string name="c_onboarding_usage_card_title">Allow usage access</string>
    <string name="c_onboarding_usage_card_body">Find Memdroid in the list and turn it on.</string>
    <string name="c_onboarding_files_title">All files access</string>
    <string name="c_onboarding_files_body">Needed for large files, duplicates, old downloads, the folder view and the recycle bin.</string>
    <string name="c_onboarding_files_card_title">Allow all files access</string>
    <string name="c_onboarding_files_card_body">Turn on Allow access to manage all files.</string>
    <string name="c_onboarding_notifications_title">Notifications</string>
    <string name="c_onboarding_notifications_body">Used for the optional low storage, low RAM and battery drain alerts. They\'re all off until you turn them on.</string>
    <string name="c_onboarding_allow_notifications">Allow notifications</string>
    <string name="c_onboarding_shizuku_title">Shizuku (optional)</string>
    <string name="c_onboarding_shizuku_body">Android doesn\'t let normal apps see or stop other apps. Shizuku gives Memdroid that access without rooting, for the running apps list, kill, auto-kill, battery by app and clearing caches. Install it, start it with wireless debugging, then come back here.</string>
    <string name="c_onboarding_get_shizuku">Get Shizuku</string>
    <string name="c_onboarding_allow_in_shizuku">Allow Memdroid in Shizuku</string>
    <string name="c_onboarding_done_title">You\'re all set</string>
    <string name="c_onboarding_done_body">Start with the Storage tab\'s smart cleanup to see what you can free. You can run this setup again from Settings.</string>
    <string name="c_onboarding_skip">Skip</string>
    <string name="c_onboarding_start">Start</string>
    <string name="c_onboarding_next">Next</string>
    <string name="c_onboarding_done">Done</string>

    <!-- Auto-kill screen -->
    <string name="c_autokill_shizuku_needed">Shizuku needed</string>
    <string name="c_autokill_shizuku_needed_body">Auto-kill can only stop apps while Shizuku is running and Memdroid has access.</string>
    <string name="c_autokill_screen_off_title">When the screen turns off</string>
    <string name="c_autokill_screen_off_body">Stops your chosen apps 30 seconds after the screen locks.</string>
    <string name="c_autokill_low_ram_title">When RAM runs low</string>
    <string name="c_autokill_low_ram_body">Checks every minute and stops your chosen apps when available RAM is below %1$d%%.</string>
    <string name="c_autokill_notification_note">While a rule is on, Memdroid keeps a small notification so Android lets it keep watching.</string>
    <string name="c_autokill_apps_to_stop">Apps to stop (%1$d)</string>
