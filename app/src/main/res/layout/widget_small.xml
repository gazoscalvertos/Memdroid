<?xml version="1.0" encoding="utf-8"?>
<!-- One row tall: a single line of figures with the buttons on the same row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/summary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:text="RAM · Storage" />

    <ImageView
        android:id="@+id/refresh"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_button"
        android:contentDescription="Refresh"
        android:padding="7dp"
        android:src="@drawable/ic_widget_refresh" />

    <ImageView
        android:id="@+id/kill_all"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button"
        android:contentDescription="Kill all"
        android:padding="7dp"
        android:src="@drawable/ic_widget_kill" />
</LinearLayout>
